GEMINI_API_KEY=
DATABASE_PATH=data/talentsphere.db

# Application Base URL for password recovery links
APP_BASE_URL=http://localhost:8501

# Password Reset Token Settings
RESET_TOKEN_EXPIRE_MINUTES=20
RESET_COOLDOWN_SECONDS=60

# Persistent Remember Me Session Settings
SESSION_SECRET_KEY=change-to-a-secure-random-secret-key-in-production
SESSION_LIFETIME_DAYS=30

# SMTP Configuration for Password Recovery Emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=TalentSphere Support <noreply@talentsphere.io>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
